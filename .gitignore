# ---------------------------------------------------------------------------
# GreenPulse — repository ignore rules
#
# NOTE: patterns here are deliberately NOT anchored with a leading slash.
# The project is a two-folder monorepo (frontend/ + backend/), so `/node_modules`
# would only match the repository root and would happily commit
# frontend/node_modules and backend/node_modules — several hundred megabytes.
# ---------------------------------------------------------------------------

# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js build output
.next/
out/
build/
dist/

# Production / deployment
.vercel
.netlify

# Environment files — never commit real secrets.
# The committed `.env.example` files document every variable instead.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript / build caches
*.tsbuildinfo
next-env.d.ts

# Testing
coverage/

# Editor and OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Certificates and keys
*.pem
*.key

# Cached vision model weights (~14 MB, re-downloaded on demand)
.cache/
