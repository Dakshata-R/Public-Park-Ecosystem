# ---------------------------------------------------------------
# Park Ecosystem Portal API — environment configuration
# Copy this file to `.env` and adjust the values. `.env` is gitignored.
# ---------------------------------------------------------------

# Port the Express server listens on (hosting platforms usually set this).
PORT=5000

# development | production | test
NODE_ENV=development

# MongoDB connection string.
# Development: leave BLANK to boot an automatic in-memory MongoDB
# (mongodb-memory-server) that is re-seeded on every start.
# Production: REQUIRED — the server refuses to start without it.
#
# Local install:  mongodb://127.0.0.1:27017/greenpulse
# MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/greenpulse
MONGODB_URI=

# Secret used to sign JWT access tokens.
# Production: REQUIRED, at least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=greenpulse-dev-secret-change-me
JWT_EXPIRES_IN=7d

# Comma-separated origins allowed to call the API (the frontend URL).
# Production: REQUIRED, e.g. https://greenpulse.vercel.app
CORS_ORIGIN=http://localhost:3000

# Seed the database automatically on boot when it has no parks.
AUTO_SEED=true

# How often (ms) sensors refresh: newer Open-Meteo observations for the
# air-quality/temperature/humidity sensors, plus one reading per simulated
# noise/soil/water sensor. 0 disables the background refresh.
SENSOR_SIMULATION_INTERVAL_MS=60000

# debug | info | warn | error | silent
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Public data sources
# ---------------------------------------------------------------------------
# No key is needed for any core feature:
#   Open-Meteo Forecast + Air Quality  live weather and CAMS pollutant data (CPCB AQI computed here)
#   GBIF                               species occurrence checks
#   OpenStreetMap Nominatim            reverse geocoding
#   TensorFlow Hub                     MobileNetV2 weights, downloaded once (~14 MB) into .cache/
#
# Parks, species and observations are loaded from the committed snapshot in
# src/seed/data/open-data (refresh with `npm run data:refresh`).
#
# Optional extras — leave blank to disable:

# ---------------------------------------------------------------------------
# Language model (optional) — Eco Assistant + AI Monitoring wildlife species ID
# ---------------------------------------------------------------------------
# With a key, the Eco Assistant answers with a language model (follow-up
# questions, live lookups through role-scoped tools) and AI Monitoring names
# animal species from photos. With no key at all, the built-in keyword engine
# and MobileNetV2 answer instead — everything still works, just without
# precise species names.
#
# Set ONE of the keys below. The provider is picked automatically from the
# first key present (Gemini → Groq → LLM_BASE_URL → Anthropic), or explicitly:
# LLM_PROVIDER=gemini | groq | openai-compatible | ollama | openrouter | anthropic | none
# LLM_PROVIDER=

# RECOMMENDED — Google Gemini, free tier, no credit card:
#   https://aistudio.google.com/apikey → "Create API key". Default model gemini-3.5-flash-lite.
GEMINI_API_KEY=

# Alternative — Groq, free tier: https://console.groq.com/keys
#   Defaults: llama-3.3-70b-versatile (assistant), qwen/qwen3.8-27b (vision).
GROQ_API_KEY=

# Local / self-hosted — any OpenAI-compatible server, no key needed for Ollama:
#   Ollama:     LLM_BASE_URL=http://localhost:11434/v1  (ollama pull llama3.2 && ollama pull llama3.2-vision)
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_API_KEY=sk-or-…
LLM_BASE_URL=
LLM_API_KEY=

# Optional — Anthropic Claude (paid): https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model overrides for whichever provider is active (blank → its default):
# ASSISTANT_MODEL=gemini-3.5-flash-lite
# VISION_MODEL=gemini-3.5-flash-lite

# https://openweathermap.org/api — alternative current-weather source
OPENWEATHER_API_KEY=

# https://ebird.org/api/keygen — recent bird observations near a park
EBIRD_API_KEY=
