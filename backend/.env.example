# ---------------------------------------------------------------
# GreenPulse API — environment configuration
# Copy this file to `.env` and adjust the values.
# ---------------------------------------------------------------

# Port the Express server listens on
PORT=5000

# Node environment: development | production | test
NODE_ENV=development

# MongoDB connection string.
# Leave BLANK to boot an automatic in-memory MongoDB instance
# (mongodb-memory-server) — handy for demos on a machine with no
# MongoDB installed. Data is lost when the process exits.
#
# Local install:  mongodb://127.0.0.1:27017/greenpulse
# Atlas:          mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/greenpulse
MONGODB_URI=

# Secret used to sign JWT access tokens. Change this in production.
JWT_SECRET=greenpulse-dev-secret-change-me
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call the API
CORS_ORIGIN=http://localhost:3000

# Seed the database automatically on boot when it is empty
AUTO_SEED=true

# Interval (ms) at which the sensor simulator emits a new reading.
# Set to 0 to disable the simulator.
SENSOR_SIMULATION_INTERVAL_MS=60000

# ---------------------------------------------------------------------------
# Public API integrations
# ---------------------------------------------------------------------------
# The two that matter most need NO key and are always on:
#   Open-Meteo Forecast + Air Quality  → live weather and real pollutant
#                                        concentrations, scored through this
#                                        project's own CPCB implementation
#   GBIF                               → species occurrence and taxonomy checks
#   OpenStreetMap Nominatim            → reverse geocoding
#
# The two below are optional. Leave them blank and the system uses the keyless
# sources instead; nothing breaks.

# https://openweathermap.org/api — alternative weather source
OPENWEATHER_API_KEY=

# https://ebird.org/api/keygen — recent bird observations near a park
EBIRD_API_KEY=

# Optional: URL of a served vision model. When set, the AI module POSTs
# {task, imageUrl} here and expects {probabilities:[{label,probability}]} back.
# Unset (the default) uses the deterministic surrogate in ai-inference.service.
AI_MODEL_ENDPOINT=
