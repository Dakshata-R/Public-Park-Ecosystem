# ---------------------------------------------------------------
# GreenPulse API — environment configuration
# Copy this file to `.env` and adjust the values. `.env` is gitignored.
# ---------------------------------------------------------------

# Port the Express server listens on (hosting platforms usually set this).
PORT=5000

# development | production | test
NODE_ENV=development

# MongoDB connection string.
# Development: leave BLANK to boot an automatic in-memory MongoDB
# (mongodb-memory-server) that is re-seeded on every start.
# Production: REQUIRED — the server refuses to start without it.
#
# Local install:  mongodb://127.0.0.1:27017/greenpulse
# MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/greenpulse
MONGODB_URI=

# Secret used to sign JWT access tokens.
# Production: REQUIRED, at least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=greenpulse-dev-secret-change-me
JWT_EXPIRES_IN=7d

# Comma-separated origins allowed to call the API (the frontend URL).
# Production: REQUIRED, e.g. https://greenpulse.vercel.app
CORS_ORIGIN=http://localhost:3000

# Seed the database automatically on boot when it has no parks.
AUTO_SEED=true

# How often (ms) sensors refresh: newer Open-Meteo observations for the
# air-quality/temperature/humidity sensors, plus one reading per simulated
# noise/soil/water sensor. 0 disables the background refresh.
SENSOR_SIMULATION_INTERVAL_MS=60000

# debug | info | warn | error | silent
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Public data sources
# ---------------------------------------------------------------------------
# No key is needed for any core feature:
#   Open-Meteo Forecast + Air Quality  live weather and CAMS pollutant data (CPCB AQI computed here)
#   GBIF                               species occurrence checks
#   OpenStreetMap Nominatim            reverse geocoding
#   TensorFlow Hub                     MobileNetV2 weights, downloaded once (~14 MB) into .cache/
#
# Parks, species and observations are loaded from the committed snapshot in
# src/seed/data/open-data (refresh with `npm run data:refresh`).
#
# Optional extras — leave blank to disable:

# https://console.anthropic.com — lets the Eco Assistant answer with Claude,
# understanding follow-up questions and looking up live park data. Blank → the
# built-in keyword retrieval engine answers instead.
ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-opus-5-5

# https://openweathermap.org/api — alternative current-weather source
OPENWEATHER_API_KEY=

# https://ebird.org/api/keygen — recent bird observations near a park
EBIRD_API_KEY=
