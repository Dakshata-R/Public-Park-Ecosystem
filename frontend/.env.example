# Copy to `.env.local` for development. Values are baked in at build time.

# Base URL of the GreenPulse API, including /api.
# Development: http://localhost:5000/api
# Production:  REQUIRED, e.g. https://greenpulse-api.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# List the demo sign-in accounts (and their shared password) on the login page.
# Convenient locally and for an assessor's demo; leave false for a public deployment.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=true
